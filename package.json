{
  "name": "cla-action",
  "version": "2.7.0",
  "description": "GitHub Action that asks pull request authors to sign a CLA or DCO and records the signatures in a repository",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && ncc build src/main.ts -o dist --license licenses.txt",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolfware-labs/cla-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "lodash": "4.18.1"
  },
  "author": "Wolfware LLC",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wolfware-labs/cla-action/issues"
  },
  "homepage": "https://github.com/wolfware-labs/cla-action#readme",
  "contributors": [
    "ibakshay",
    "SAP"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "devDependencies": {
    "@types/lodash": "4.17.26",
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
